{
  "name": "@geo-soft/timetablely-sdk",
  "version": "1.0.0",
  "description": "Embeddable timetable scheduler SDK based on Timetablely",
  "main": "./dist/timetablely-sdk.umd.js",
  "module": "./dist/timetablely-sdk.es.js",
  "types": "./dist/index.d.ts",
  "style": "./styles/scheduler.css",
  "exports": {
    ".": {
      "import": "./dist/timetablely-sdk.es.js",
      "require": "./dist/timetablely-sdk.umd.js",
      "types": "./dist/index.d.ts"
    },
    "./styles": "./styles/scheduler.css"
  },
  "files": [
    "dist",
    "styles",
    "README.md"
  ],
  "scripts": {
    "build:css": "tailwindcss -i ./src/styles/tailwind.css -o ./styles/scheduler.css --minify",
    "build": "pnpm build:css && vite build",
    "build:watch": "vite build --watch",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "rimraf dist",
    "prepare": "husky",
    "commit-config": "node dice.config.ts"
  },
  "keywords": [
    "timetable",
    "scheduler",
    "sdk",
    "react",
    "timetablely"
  ],
  "author": {
    "name": "ArziBlack",
    "email": "arziblack2@gmail.com",
    "url": "https://github.com/arziblack"
  },
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.4.1",
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.18",
    "@types/node": "^25.0.10",
    "@types/react": "^19.2.9",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^5.1.2",
    "husky": "^9.1.7",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "rimraf": "^6.1.2",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vite-plugin-dts": "^4.5.4"
  }
}
